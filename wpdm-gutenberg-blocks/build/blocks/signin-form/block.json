{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "download-manager/signin-form",
  "version": "3.0.0",
  "title": "Login Form",
  "category": "wpdm-blocks",
  "description": "Display a user login form with customizable options.",
  "keywords": [
    "download",
    "login",
    "signin",
    "form",
    "user",
    "wpdm"
  ],
  "textdomain": "wpdm-gblocks",
  "supports": {
    "html": false,
    "className": true,
    "customClassName": true
  },
  "attributes": {
    "logo": {
      "type": "string",
      "default": ""
    },
    "note_before": {
      "type": "string",
      "default": ""
    },
    "note_after": {
      "type": "string",
      "default": ""
    },
    "regurl": {
      "type": "string",
      "default": ""
    },
    "redirect": {
      "type": "string",
      "default": ""
    }
  }
}